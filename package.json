{
  "name": "mortgage-site",
  "version": "1.0.0",
  "private": true,
  "description": "Mortgage landing page — Tailwind CSS v4, vanilla JS",
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./dist/css/style.css --minify",
    "build": "npm run build:pages && npm run build:css",
    "dev": "npm run build:pages && tailwindcss -i ./src/css/main.css -o ./dist/css/style.css --watch",
    "serve": "npx --yes serve ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "tailwindcss": "^4.1.4"
  }
}
